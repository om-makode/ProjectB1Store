APP_ENV=development

# Local stack from `npx supabase start` (see ../supabase).
#   iOS simulator:        http://127.0.0.1:54321
#   Android emulator:     http://10.0.2.2:54321
#   Real phone on Wi-Fi:  http://<your Mac's LAN IP>:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The anon / publishable key printed by `npx supabase status`.
# Safe to ship in the app ONLY because RLS is on for every table.
# Never put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-me-with-the-anon-key

# Used for share links and web product pages (Phase 8)
EXPO_PUBLIC_WEB_URL=http://localhost:8081

# Google sign-in (optional). Leave empty to show email login only. See docs/required/NEXT_STEPS.md → Phase 3.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Push notifications (Phase 5): the EAS project id from `npx eas-cli init` (needs your Expo account).
# Leave empty until then: the in-app notification inbox works without it.
EAS_PROJECT_ID=

# Dev-only: set to true to show email + password login for test accounts
EXPO_PUBLIC_DEV_PASSWORD_LOGIN=
